FROM python:3.10-slim

USER root

# Install system dependencies manually
RUN apt-get update && apt-get install -y \
    libgbm-dev libnss3 libasound2 libxss1 libxtst6 \
    git wget \
    fonts-unifont \
    fonts-liberation \
    libvpx-dev \
    && rm -rf /var/lib/apt/lists/*

# Setup non-root user (UID 1000)
RUN useradd -m -u 1000 user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/home/user/app

WORKDIR $HOME/app

# Copy all files
COPY --chown=user:user . .

# Install Crawl4AI
RUN pip install --no-cache-dir ".[api,sync]"

# Install ONLY the browser
RUN python -m playwright install chromium

# Ensure permissions are correct after install
RUN chown -R user:user $HOME/app

USER user
EXPOSE 7860

CMD ["uvicorn", "crawl4ai.api.main:app", "--host", "0.0.0.0", "--port", "7860"]
