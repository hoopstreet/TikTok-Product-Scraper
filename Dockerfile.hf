FROM python:3.10-slim

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgbm-dev libnss3 libasound2 libxss1 libxtst6 \
    git wget \
    fonts-unifont \
    fonts-liberation \
    libvpx-dev \
    && rm -rf /var/lib/apt/lists/*

# Setup user
RUN useradd -m -u 1000 user
WORKDIR /home/user/app

# Set environment variables
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/home/user/app

# Copy your project files
COPY --chown=user:user . .

# 1. Install the official crawl4ai and server requirements
# We install from the official repo to ensure the 'api' submodule is present
RUN pip install --no-cache-dir "crawl4ai[api,sync]" uvicorn fastapi gunicorn jinja2

# 2. Install Playwright
RUN python -m playwright install chromium

# 3. Permissions fix
RUN chown -R user:user /home/user/app

USER user
EXPOSE 7860

# Start the app using the main.py we found in your root
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
