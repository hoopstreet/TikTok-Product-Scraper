FROM python:3.10-slim

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgbm-dev libnss3 libasound2 libxss1 libxtst6 \
    git wget \
    fonts-unifont \
    fonts-liberation \
    libvpx-dev \
    && rm -rf /var/lib/apt/lists/*

# Setup user 1000
RUN useradd -m -u 1000 user
WORKDIR /home/user/app

# Set environment variables so Python finds the binaries
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1

# Copy files and give ownership to user
COPY --chown=user:user . .

# Switch to user for installation
USER user

# Install Crawl4AI and API components into the user local path
RUN pip install --no-cache-dir --user ".[api,sync]"

# Install Playwright browser
RUN python -m playwright install chromium

EXPOSE 7860

# Start using python -m to bypass PATH issues
CMD ["python", "-m", "uvicorn", "crawl4ai.api.main:app", "--host", "0.0.0.0", "--port", "7860"]
