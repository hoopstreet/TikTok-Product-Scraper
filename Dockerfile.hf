FROM python:3.10-slim

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgbm-dev libnss3 libasound2 libxss1 libxtst6 \
    git wget \
    fonts-unifont \
    fonts-liberation \
    libvpx-dev \
    && rm -rf /var/lib/apt/lists/*

# Setup user
RUN useradd -m -u 1000 user
WORKDIR /home/user/app

# Set environment variables
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/home/user/app

# Copy files
COPY --chown=user:user . .

# Install dependencies - we force the install of the local directory
RUN pip install --no-cache-dir . 
RUN pip install --no-cache-dir uvicorn fastapi gunicorn

# Install Playwright
RUN python -m playwright install chromium

# Final permission fix
RUN chown -R user:user /home/user/app

USER user
EXPOSE 7860

# Force uvicorn to look at the current directory's main.py
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
