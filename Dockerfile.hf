FROM python:3.10-slim

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgbm-dev libnss3 libasound2 libxss1 libxtst6 \
    git wget \
    fonts-unifont \
    fonts-liberation \
    libvpx-dev \
    && rm -rf /var/lib/apt/lists/*

# Setup user 1000
RUN useradd -m -u 1000 user
WORKDIR /home/user/app

# Set environment variables
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/home/user/app

# Copy files
COPY --chown=user:user . .

# 1. Install dependencies + explicit FastAPI/Uvicorn
RUN pip install --no-cache-dir ".[api,sync]" uvicorn fastapi gunicorn

# 2. Install Playwright browser
RUN python -m playwright install chromium

# 3. Fix permissions
RUN chown -R user:user /home/user/app

# Switch to non-root user
USER user

EXPOSE 7860

# We use the full module path. 
# If your folder has a file named main.py inside crawl4ai/api/, this is the path:
CMD ["python", "-m", "uvicorn", "crawl4ai.api.main:app", "--host", "0.0.0.0", "--port", "7860"]
