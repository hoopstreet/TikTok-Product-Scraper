FROM python:3.10-slim

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgbm-dev libnss3 libasound2 libxss1 libxtst6 \
    git wget \
    fonts-unifont \
    fonts-liberation \
    libvpx-dev \
    && rm -rf /var/lib/apt/lists/*

# Setup user 1000
RUN useradd -m -u 1000 user
WORKDIR /home/user/app

# Set environment variables
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1

# Copy files
COPY . .

# 1. Install dependencies + EXPLICIT uvicorn/fastapi
# This ensures the executable is present even if the main package fails to link it
RUN pip install --no-cache-dir ".[api,sync]" uvicorn fastapi gunicorn

# 2. Install Playwright browser
RUN python -m playwright install chromium

# 3. Fix permissions for Hugging Face
RUN chown -R user:user /home/user

# Switch to non-root user
USER user

EXPOSE 7860

# Start using uvicorn directly (since we verified it's installed now)
CMD ["python", "-m", "uvicorn", "crawl4ai.api.main:app", "--host", "0.0.0.0", "--port", "7860"]
